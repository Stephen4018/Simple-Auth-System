{
	"info": {
		"_postman_id": "8b86505b-9014-49db-8b6a-ff580e902cb6",
		"name": "Auth System API",
		"description": "Collection for testing the Auth System API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
